	<rdfs:description xml:lang="sk">Obsahuje reprezentáciu telekomunikačného číselného reťazca. Vypĺňa sa v súlade s aktuálnym číslovacím plánom, ktorý svojim opatrením vydáva Úrad pre reguláciu elektronických komunikácií a poštových služieb.</rdfs:description>
</rdf:Description>

<rdf:Description rdf:about="https://data.gov.sk/def/ontology/egov/internationalAreaCode">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
	<rdfs:label xml:lang="sk">medzinárodné smerové číslo</rdfs:label>
	<rdfs:label xml:lang="de">internationale Vorwahlr</rdfs:label>
	<rdfs:label xml:lang="en">international area code</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<kdp:xmlElementName>InternationalCountryCode</kdp:xmlElementName>
	<rdfs:isDefinedBy rdf:resource="https://data.gov.sk/def/ontology/egov/2025c"/>
	<rdfs:domain rdf:resource="https://data.gov.sk/def/ontology/egov/TelephoneNumber"/>
	<skos:example xml:lang="sk">+421, 00421</skos:example>
	<adms:identifier rdf:resource="https://data.gov.sk/id/identifier/kdp-id/D.1.4.2.2"/>
	<rdfs:description xml:lang="sk">Kód krajiny podľa ITU, ktorý identifikuje špecifickú krajinu, krajiny v integrovanom číselnom pláne alebo špecifickú geografickú oblasť. Vypĺňa sa v súlade s aktuálnym číslovacím plánom, ktorý svojim opatrením vydáva Úrad pre reguláciu elektronických komunikácií a poštových služieb.</rdfs:description>
</rdf:Description>

<rdf:Description rdf:about="https://data.gov.sk/def/ontology/egov/nationalNumber">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
	<rdfs:label xml:lang="sk">národné číslo</rdfs:label>
	<rdfs:label xml:lang="de">nationale Nummer</rdfs:label>
	<rdfs:label xml:lang="en">national number</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<skos:note xml:lang="sk">V Slovenskej republike sa nepoužíva.</skos:note>
	<kdp:xmlElementName>NationalNumber</kdp:xmlElementName>
	<rdfs:isDefinedBy rdf:resource="https://data.gov.sk/def/ontology/egov/2025c"/>
	<rdfs:domain rdf:resource="https://data.gov.sk/def/ontology/egov/TelephoneNumber"/>
	<adms:identifier rdf:resource="https://data.gov.sk/id/identifier/kdp-id/D.1.4.2.3"/>
	<rdfs:description xml:lang="sk">Obsahuje národné číslo. Niektoré oblasti majú dve predvoľby – vnútroštátne a zahraničné medzimestské predvoľby, tento prvok obsahuje vnútroštátnu predvoľbu.</rdfs:description>
</rdf:Description>

<rdf:Description rdf:about="https://data.gov.sk/def/ontology/egov/areaCityCode">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
	<rdfs:label xml:lang="sk">smerové číslo</rdfs:label>
	<rdfs:label xml:lang="de">routing Nummer</rdfs:label>
	<rdfs:label xml:lang="en">area city code</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<skos:note xml:lang="sk">V Slovenskej republike je to ekvivalent národného cieľového kódu.</skos:note>
	<kdp:xmlElementName>AreaCityCode</kdp:xmlElementName>
	<rdfs:isDefinedBy rdf:resource="https://data.gov.sk/def/ontology/egov/2025c"/>
	<rdfs:domain rdf:resource="https://data.gov.sk/def/ontology/egov/TelephoneNumber"/>
	<adms:identifier rdf:resource="https://data.gov.sk/id/identifier/kdp-id/D.1.4.2.4"/>
	<rdfs:description xml:lang="sk">Definuje buď číslovanie v rámci jednej krajiny (alebo skupiny krajín či geografickej oblasti) alebo sieť – službu. Relácia na reprezentáciu telekomunikačného číselného reťazca. Vypĺňa sa v súlade s aktuálnym číslovacím plánom, ktorý svojim opatrením vydáva Úrad pre reguláciu elektronických komunikácií a poštových služieb.</rdfs:description>
</rdf:Description>

<rdf:Description rdf:about="https://data.gov.sk/def/ontology/egov/internetAddress">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
	<rdfs:label xml:lang="sk">internetová adresa</rdfs:label>
	<rdfs:label xml:lang="de">Internetadresse</rdfs:label>
	<rdfs:label xml:lang="en">internet address</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<kdp:xmlElementName>InternetAddress</kdp:xmlElementName>
	<rdfs:isDefinedBy rdf:resource="https://data.gov.sk/def/ontology/egov/2025c"/>
	<rdfs:domain rdf:resource="https://data.gov.sk/def/ontology/egov/ElectronicAddress"/>
	<adms:identifier rdf:resource="https://data.gov.sk/id/identifier/kdp-id/D.1.5.1"/>
	<rdfs:description xml:lang="sk">Uvádza sa kontakt pre rôzne typy elektronických adries v prostredí internetu. Rozoznávajú sa typy ako mailto (mailová adresa), http (webová adresa), ftp, ldap a podobne. Časť adresy vo väčšine prípadov dodržiava radenie textových reťazcov podľa podradenia doménových mien.</rdfs:description>
</rdf:Description>

